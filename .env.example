# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=neurolens
POSTGRES_PASSWORD=neurolens_dev
POSTGRES_DB=neurolens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── MinIO (Object Storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=neurolens-docs

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=document_chunks

# ─── Ollama (Local LLM) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── NPU / ONNX ───────────────────────────────────────────────────────────────
# Options: VitisAIExecutionProvider, DmlExecutionProvider, CPUExecutionProvider
# Start with CPUExecutionProvider to confirm things work, then switch to VitisAI
NPU_EXECUTION_PROVIDER=VitisAIExecutionProvider
NPU_FALLBACK_PROVIDER=CPUExecutionProvider

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
LOG_LEVEL=info
ENVIRONMENT=development
